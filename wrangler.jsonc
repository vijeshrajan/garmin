{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin",
  "main": "dist/_worker.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 */2 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "FITNESS_DB",
      "database_name": "garmin-advisor",
      "database_id": "523d273e-5268-4354-b047-62c236314841"
    }
  ]
}

